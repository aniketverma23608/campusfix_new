{
  "name": "ai-campusfix",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server/server.js\" \"vite --config client/vite.config.js\"",
    "dev:server": "node --watch server/server.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/server.js",
    "seed:admin": "node server/utils/seedAdmin.js"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@vitejs/plugin-react": "4.7.0",
    "bcryptjs": "^3.0.2",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "0.468.0",
    "mongoose": "^8.19.1",
    "multer": "^2.0.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "vite": "6.4.6"
  }
}
